/-- Test the width before evaluating the gradient magnitude. -/
private noncomputable def sparseValue (D : Int) (B : Fin 4 → FixedTape.I)
    (G C : FixedTape.Row) : Int :=
  2*D*C.value.hi + ∑ i : Fin 4,
    if (B i).hi-(B i).lo = 0 then 0
    else (max (G.gradient i).lo.natAbs (G.gradient i).hi.natAbs : Int)*
      ((B i).hi-(B i).lo)

private theorem sparseValue_eq_dense (D : Int) (B : Fin 4 → FixedTape.I)
    (G C : FixedTape.Row) :
    sparseValue D B G C = 2*D*C.value.hi + ∑ i : Fin 4,
      (max (G.gradient i).lo.natAbs (G.gradient i).hi.natAbs : Int)*
        ((B i).hi-(B i).lo) := by
  unfold sparseValue
  apply congrArg (fun z : Int => 2*D*C.value.hi+z)
  apply Finset.sum_congr rfl
  intro i hi
  by_cases hw : (B i).hi-(B i).lo = 0
  · simp [hw]
  · simp [hw]

theorem dense_nonpos_of_sparse (D : Int) (B : Fin 4 → FixedTape.I)
    (G C : FixedTape.Row) (hs : sparseValue D B G C ≤ 0) :
    2*D*C.value.hi + ∑ i : Fin 4,
      (max (G.gradient i).lo.natAbs (G.gradient i).hi.natAbs : Int)*
        ((B i).hi-(B i).lo) ≤ 0 := by
  rwa [sparseValue_eq_dense] at hs


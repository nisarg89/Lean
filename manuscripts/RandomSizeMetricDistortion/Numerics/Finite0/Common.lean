theorem finite_family_from_source_cases
    (htable : Contracts.Numerics_TableCoverage.Statement)
    (hcells : FiniteSourceCaseBounds) (hcross : StrongCrossing (0 : Fin 9))
    (hshift : 0 ≤ shift (0 : Fin 9)) : FiniteFamily (0 : Fin 9) := by
  have hcases : FiniteCaseBounds (0 : Fin 9) := by
    constructor
    · intro r hr p hp a ha hap hcase
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.lowFirstBottom i p a r hp ⟨hlo,hhi⟩ hL hT hk0 hr ha hap hcase
    · intro r hr p hp a ha hap hcase
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.lowFirstTop i p a r hp ⟨hlo,hhi⟩ hL hT hk0 hk1 hr ha hap hcase
    · intro r hr p hp a A ha hap hpA hAr
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.lowInternal i p a A r hp ⟨hlo,hhi⟩ hL hT hk0 hk1 hr ha hap hpA hAr
    · intro r hr p hp a ha hap hcase
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.highFirstBottom i p a r hp ⟨hlo,hhi⟩ hL hT hkb hr ha hap hcase
    · intro r hr p hp a ha hap hcase
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.highFirstTop i p a r hp ⟨hlo,hhi⟩ hL hT hkb hr ha hap hcase
    · intro r hr p hp a A ha hap hpA hAr hcase
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.highInternalBottom i p a A r hp ⟨hlo,hhi⟩ hL hT hkb hr ha hap hpA hAr hcase
    · intro r hr p hp a A ha hap hpA hAr hcase
      obtain ⟨i,hlo,hhi,hL,hT,hk0,hk1,hkb⟩ := source_cover htable p hp
      exact hcells.highInternalTop i p a A r hp ⟨hlo,hhi⟩ hL hT hkb hr ha hap hpA hAr hcase
  exact finite_family_from_cases (0 : Fin 9) hcases hcross hshift

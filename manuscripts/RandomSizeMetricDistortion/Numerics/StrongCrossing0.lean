private noncomputable def sourceCell (i : ℕ) : SourceCell := sourceCells.getD i ⟨0,0,fun _ => 0,fun _ => 0⟩
private noncomputable def priceLambda (i : ℕ) (p : ℝ) : ℝ :=
  (∑ k : Fin 4, ((sourceCell i).lambdaCoeffs k : ℝ)*p^k.val)/(p*(1-p))
private noncomputable def priceTau (i : ℕ) (p : ℝ) : ℝ :=
  (∑ k : Fin 4, ((sourceCell i).tauCoeffs k : ℝ)*p^k.val)/(p*(1-p))
private noncomputable def rowCheck (c : MassCell) (i : ℕ) : Bool :=
  decide (i < sourceCells.length ∧ (sourceCell i).lo ≤ c.lo ∧ c.hi ≤ (sourceCell i).hi ∧
    c.lambdaNum.length ≤ 4 ∧ (c.tauNums.getD 0 []).length ≤ 4) &&
  (List.finRange 4).all (fun k => decide (c.lambdaNum.getD k.val 0 = (sourceCell i).lambdaCoeffs k ∧
    (c.tauNums.getD 0 []).getD k.val 0 = (sourceCell i).tauCoeffs k))
private noncomputable def rowsCheck : List MassCell → List ℕ → Bool
  | [],[] => true
  | c::cs,i::is => rowCheck c i && rowsCheck cs is
  | _,_ => false
private theorem checked : rowsCheck fixedCells caseMap = true := by decide +kernel
private theorem checks_sound (cs : List MassCell) (is : List ℕ) (hc : rowsCheck cs is = true) :
    List.Forall₂ (fun c i => rowCheck c i = true) cs is := by
  induction cs generalizing is with
  | nil => cases is <;> simp [rowsCheck] at hc ⊢
  | cons c cs ih =>
    cases is with
    | nil => simp [rowsCheck] at hc
    | cons i is =>
      have hh : rowCheck c i = true ∧ rowsCheck cs is = true := by
        simpa only [rowsCheck,Bool.and_eq_true_iff] using hc
      exact List.Forall₂.cons hh.1 (ih is hh.2)
private theorem eval_four (row : List ℚ) (hlen : row.length ≤ 4) (p : ℝ) :
    evalQPoly row p = (row.getD 0 0 : ℝ)+(row.getD 1 0 : ℝ)*p+
      (row.getD 2 0 : ℝ)*p^2+(row.getD 3 0 : ℝ)*p^3 := by
  unfold evalQPoly
  have heq : (∑ i ∈ Finset.range row.length, (row.getD i 0 : ℝ)*p^i) =
      ∑ i ∈ Finset.range 4, (row.getD i 0 : ℝ)*p^i := by
    apply Finset.sum_subset (Finset.range_mono hlen)
    intro i hi hnot
    have hbig : row.length ≤ i := Nat.le_of_not_gt (by simpa using hnot)
    rw [List.getD_eq_default row 0 hbig]
    simp
  rw [heq]
  norm_num [Finset.sum_range_succ] <;> ring

private theorem eval_fin (row : List ℚ) (hlen : row.length ≤ 4) (p : ℝ) :
    evalQPoly row p = ∑ k : Fin 4, (row.getD k.val 0 : ℝ)*p^k.val := by
  rw [eval_four row hlen]
  norm_num [Fin.sum_univ_succ] <;> ring
private theorem selected_cell (hcover : ∀ p ∈ Ioo (0 : ℝ) 1,
    ∃ c ∈ fixedCells, (c.lo : ℝ) ≤ p ∧ p < (c.hi : ℝ))
    (p : ℝ) (hp : p ∈ Ioo (0 : ℝ) 1) :
    ∃ c, fixedCell p = c ∧ c ∈ fixedCells ∧ (c.lo : ℝ) ≤ p ∧ p < (c.hi : ℝ) := by
  classical
  cases hfind : fixedCells.find? (fun c => decide ((c.lo : ℝ) ≤ p ∧ p < (c.hi : ℝ))) with
  | none =>
    obtain ⟨c,hc,hbounds⟩ := hcover p hp
    have hn := List.find?_eq_none.mp hfind c hc
    exact False.elim (hn (by simpa using hbounds))
  | some c =>
    have hb : (c.lo : ℝ) ≤ p ∧ p < (c.hi : ℝ) :=
      of_decide_eq_true (List.find?_some
        (p := fun d : MassCell => decide ((d.lo : ℝ) ≤ p ∧ p < (d.hi : ℝ)))
        (l := fixedCells) hfind)
    exact ⟨c,by unfold fixedCell; rw [hfind]; rfl,List.mem_of_find?_eq_some hfind,hb.1,hb.2⟩

theorem price_coverage (hcover : ∀ p ∈ Ioo (0 : ℝ) 1,
    ∃ c ∈ fixedCells, (c.lo : ℝ) ≤ p ∧ p < (c.hi : ℝ)) :
    ∀ p ∈ Ioo (0 : ℝ) 1, ∃ i : Fin 128,
      ((sourceCell i.val).lo : ℝ) ≤ p ∧ p < ((sourceCell i.val).hi : ℝ) ∧
      lambdaStar p = priceLambda i.val p ∧ tauStar 0 p = priceTau i.val p := by
  intro p hp
  obtain ⟨c,hsel,hc,hlo,hhi⟩ := selected_cell hcover p hp
  obtain ⟨n,hn,he⟩ := List.getElem_of_mem hc
  have hall := checks_sound fixedCells caseMap checked
  have hn' : n < caseMap.length := by simpa only [← hall.length_eq] using hn
  have hr := hall.get hn hn'
  have he' : fixedCells.get ⟨n,hn⟩ = c := by simpa using he
  rw [he'] at hr
  let i : ℕ := caseMap.getD n 0
  have hrow : rowCheck c i = true := by
    dsimp [i]
    rw [List.getD_eq_get caseMap 0 ⟨n,hn'⟩]
    exact hr
  have hh :
      (i < sourceCells.length ∧ (sourceCell i).lo ≤ c.lo ∧ c.hi ≤ (sourceCell i).hi ∧
        c.lambdaNum.length ≤ 4 ∧ (c.tauNums.getD 0 []).length ≤ 4) ∧
      (List.finRange 4).all (fun k => decide (c.lambdaNum.getD k.val 0 = (sourceCell i).lambdaCoeffs k ∧
        (c.tauNums.getD 0 []).getD k.val 0 = (sourceCell i).tauCoeffs k)) = true := by
    simpa only [rowCheck,Bool.and_eq_true_iff,decide_eq_true_eq] using hrow
  obtain ⟨hi,hclo,hchi,hlenL,hlenT⟩ := hh.1
  have hcoeff : ∀ k : Fin 4, c.lambdaNum.getD k.val 0 = (sourceCell i).lambdaCoeffs k ∧
      (c.tauNums.getD 0 []).getD k.val 0 = (sourceCell i).tauCoeffs k := by
    intro k
    exact of_decide_eq_true (List.all_eq_true.mp hh.2 k (by simp))
  have hnL : evalQPoly c.lambdaNum p = ∑ k : Fin 4, ((sourceCell i).lambdaCoeffs k : ℝ)*p^k.val := by
    rw [eval_fin _ hlenL]
    apply Finset.sum_congr rfl
    intro k hk
    rw [(hcoeff k).1]
  have hnT : evalQPoly (c.tauNums.getD 0 []) p = ∑ k : Fin 4, ((sourceCell i).tauCoeffs k : ℝ)*p^k.val := by
    rw [eval_fin _ hlenT]
    apply Finset.sum_congr rfl
    intro k hk
    rw [(hcoeff k).2]
  have hp0 : p ≠ 0 := ne_of_gt hp.1
  have hp1 : p ≠ 1 := ne_of_lt hp.2
  have hlen : sourceCells.length = 128 := by decide +kernel
  have hib : i < 128 := by rwa [hlen] at hi
  refine ⟨⟨i,hib⟩,?_,?_,?_,?_⟩
  · exact (show ((sourceCell i).lo : ℝ) ≤ c.lo by exact_mod_cast hclo).trans hlo
  · exact hhi.trans_le (show (c.hi : ℝ) ≤ (sourceCell i).hi by exact_mod_cast hchi)
  · rw [lambdaStar,if_neg (not_or_intro hp0 hp1),hsel,hnL]
    rfl
  · rw [tauStar,if_neg hp0,if_neg hp1,hsel]
    change evalQPoly (c.tauNums.getD 0 []) p/(p*(1-p)) = priceTau i p
    rw [hnT]
    rfl

private noncomputable def qSum (coeffs : Fin 4 → ℚ) (p : ℚ) : ℚ := ∑ k, coeffs k*p^k.val
private noncomputable def endpointCheck (i : Fin 128) : Bool :=
  if i.val = 0 then decide ((sourceCell 0).lo = 0) else
    decide ((sourceCell (i.val-1)).hi = (sourceCell i.val).lo ∧
      (sourceCell (i.val-1)).lo < (sourceCell i.val).lo ∧
      qSum (sourceCell (i.val-1)).lambdaCoeffs (sourceCell i.val).lo =
        qSum (sourceCell i.val).lambdaCoeffs (sourceCell i.val).lo ∧
      qSum (sourceCell (i.val-1)).tauCoeffs (sourceCell i.val).lo =
        qSum (sourceCell i.val).tauCoeffs (sourceCell i.val).lo)
private theorem endpoints_checked : (List.finRange 128).all endpointCheck = true := by
  decide +kernel
private theorem first_lo_zero : (sourceCell 0).lo = 0 := by decide +kernel

private theorem endpoint_sound (i : Fin 128) (hi : 0 < i.val) :
    (sourceCell (i.val-1)).hi = (sourceCell i.val).lo ∧
    (sourceCell (i.val-1)).lo < (sourceCell i.val).lo ∧
    qSum (sourceCell (i.val-1)).lambdaCoeffs (sourceCell i.val).lo =
      qSum (sourceCell i.val).lambdaCoeffs (sourceCell i.val).lo ∧
    qSum (sourceCell (i.val-1)).tauCoeffs (sourceCell i.val).lo =
      qSum (sourceCell i.val).tauCoeffs (sourceCell i.val).lo := by
  have hh : endpointCheck i = true := List.all_eq_true.mp endpoints_checked i (by simp)
  simpa only [endpointCheck,if_neg (Nat.ne_of_gt hi),decide_eq_true_eq] using hh

private theorem endpoint_prices (i : Fin 128) (hi : 0 < i.val) :
    priceLambda (i.val-1) ((sourceCell i.val).lo : ℝ) = priceLambda i.val ((sourceCell i.val).lo : ℝ) ∧
    priceTau (i.val-1) ((sourceCell i.val).lo : ℝ) = priceTau i.val ((sourceCell i.val).lo : ℝ) := by
  have hh := endpoint_sound i hi
  have hLq := hh.2.2.1
  have hTq := hh.2.2.2
  unfold qSum at hLq hTq
  have hL : (∑ k : Fin 4, ((sourceCell (i.val-1)).lambdaCoeffs k : ℝ)*
      ((sourceCell i.val).lo : ℝ)^k.val) =
      ∑ k : Fin 4, ((sourceCell i.val).lambdaCoeffs k : ℝ)*((sourceCell i.val).lo : ℝ)^k.val := by
    exact_mod_cast hLq
  have hT : (∑ k : Fin 4, ((sourceCell (i.val-1)).tauCoeffs k : ℝ)*
      ((sourceCell i.val).lo : ℝ)^k.val) =
      ∑ k : Fin 4, ((sourceCell i.val).tauCoeffs k : ℝ)*((sourceCell i.val).lo : ℝ)^k.val := by
    exact_mod_cast hTq
  constructor
  · unfold priceLambda
    rw [hL]
  · unfold priceTau
    rw [hT]

private theorem left_cover_with_property {α : Type*} (cells : Set α) (lo hi : α → ℝ)
    (P : α → ℝ → Prop)
    (hcover : ∀ p ∈ Ioo (0 : ℝ) 1, ∃ c ∈ cells, lo c ≤ p ∧ p < hi c ∧ P c p)
    (hprevious : ∀ c ∈ cells, 0 < lo c → ∃ d ∈ cells,
      lo d < hi d ∧ hi d = lo c ∧ (P c (hi d) → P d (hi d))) :
    ∀ p ∈ Ioo (0 : ℝ) 1, ∃ c ∈ cells, lo c < p ∧ p ≤ hi c ∧ P c p := by
  intro p hp
  obtain ⟨c,hc,hlo,hhi,hP⟩ := hcover p hp
  by_cases hstrict : lo c < p
  · exact ⟨c,hc,hstrict,hhi.le,hP⟩
  · have hpeq : p = lo c := le_antisymm (le_of_not_gt hstrict) hlo
    have hpos : 0 < lo c := by simpa only [← hpeq] using hp.1
    obtain ⟨d,hd,hwidth,hjoin,htransfer⟩ := hprevious c hc hpos
    have hdp : hi d = p := hjoin.trans hpeq.symm
    rw [hdp] at hwidth htransfer
    exact ⟨d,hd,hwidth,hdp.ge,htransfer hP⟩

theorem price_coverage_left (hcover : ∀ p ∈ Ioo (0 : ℝ) 1,
    ∃ c ∈ fixedCells, (c.lo : ℝ) ≤ p ∧ p < (c.hi : ℝ)) :
    ∀ p ∈ Ioo (0 : ℝ) 1, ∃ i : Fin 128,
      ((sourceCell i.val).lo : ℝ) < p ∧ p ≤ ((sourceCell i.val).hi : ℝ) ∧
      lambdaStar p = priceLambda i.val p ∧ tauStar 0 p = priceTau i.val p := by
  let lo : Fin 128 → ℝ := fun i => (sourceCell i.val).lo
  let hi : Fin 128 → ℝ := fun i => (sourceCell i.val).hi
  let P : Fin 128 → ℝ → Prop := fun i p => lambdaStar p = priceLambda i.val p ∧ tauStar 0 p = priceTau i.val p
  have hright : ∀ p ∈ Ioo (0 : ℝ) 1, ∃ i ∈ (Set.univ : Set (Fin 128)),
      lo i ≤ p ∧ p < hi i ∧ P i p := by
    intro p hp
    obtain ⟨i,hlo,hhi,hL,hT⟩ := price_coverage hcover p hp
    exact ⟨i,Set.mem_univ _,hlo,hhi,hL,hT⟩
  have hprev : ∀ i ∈ (Set.univ : Set (Fin 128)), 0 < lo i → ∃ d ∈ (Set.univ : Set (Fin 128)),
      lo d < hi d ∧ hi d = lo i ∧ (P i (hi d) → P d (hi d)) := by
    intro i hiMem hpos
    by_cases hzero : i.val = 0
    · have h0 : lo i = 0 := by dsimp [lo]; rw [hzero,first_lo_zero]; norm_num
      rw [h0] at hpos
      linarith
    · have hip : 0 < i.val := Nat.pos_of_ne_zero hzero
      let d : Fin 128 := ⟨i.val-1,by have := i.isLt; omega⟩
      have hs := endpoint_sound i hip
      have hp := endpoint_prices i hip
      have hjoin : hi d = lo i := by
        change ((sourceCell (i.val-1)).hi : ℝ) = ((sourceCell i.val).lo : ℝ)
        exact_mod_cast hs.1
      have hwidth : lo d < hi d := by
        rw [hjoin]
        change ((sourceCell (i.val-1)).lo : ℝ) < ((sourceCell i.val).lo : ℝ)
        exact_mod_cast hs.2.1
      refine ⟨d,Set.mem_univ _,hwidth,hjoin,?_⟩
      intro hP
      change lambdaStar (hi d) = priceLambda d.val (hi d) ∧ tauStar 0 (hi d) = priceTau d.val (hi d)
      change lambdaStar (hi d) = priceLambda i.val (hi d) ∧ tauStar 0 (hi d) = priceTau i.val (hi d) at hP
      rw [hjoin] at hP ⊢
      exact ⟨hP.1.trans hp.1.symm,hP.2.trans hp.2.symm⟩
  intro p hp
  obtain ⟨i,hiMem,hlo,hhi,hL,hT⟩ := left_cover_with_property Set.univ lo hi P hright hprev p hp
  exact ⟨i,hlo,hhi,hL,hT⟩



private noncomputable def thresholdCheck (i : Fin 128) (j : Fin 9) : Bool :=
  decide ((sourceCell i.val).hi ≤ rootLows.getD j.val 0 ∨ rootLows.getD j.val 0 ≤ (sourceCell i.val).lo) &&
  (decide ((sourceCell i.val).hi ≤ rootHighs.getD j.val 0 ∨ rootHighs.getD j.val 0 ≤ (sourceCell i.val).lo) &&
   decide ((sourceCell i.val).hi ≤ (2840189/5000000 : ℚ) ∨ (2840189/5000000 : ℚ) ≤ (sourceCell i.val).lo))
private theorem thresholds_checked :
    (List.finRange 128).all (fun i => (List.finRange 9).all (thresholdCheck i)) = true := by
  decide +kernel

theorem source_thresholds (i : Fin 128) (j : Fin 9) :
    (((sourceCell i.val).hi : ℝ) ≤ (rootLows.getD j.val 0 : ℝ) ∨
      (rootLows.getD j.val 0 : ℝ) ≤ ((sourceCell i.val).lo : ℝ)) ∧
    (((sourceCell i.val).hi : ℝ) ≤ (rootHighs.getD j.val 0 : ℝ) ∨
      (rootHighs.getD j.val 0 : ℝ) ≤ ((sourceCell i.val).lo : ℝ)) ∧
    (((sourceCell i.val).hi : ℝ) ≤ bStar ∨ bStar ≤ ((sourceCell i.val).lo : ℝ)) := by
  have hi : (List.finRange 9).all (thresholdCheck i) = true :=
    List.all_eq_true.mp thresholds_checked i (by simp)
  have hij : thresholdCheck i j = true := List.all_eq_true.mp hi j (by simp)
  have hq :
      ((sourceCell i.val).hi ≤ rootLows.getD j.val 0 ∨ rootLows.getD j.val 0 ≤ (sourceCell i.val).lo) ∧
      ((sourceCell i.val).hi ≤ rootHighs.getD j.val 0 ∨ rootHighs.getD j.val 0 ≤ (sourceCell i.val).lo) ∧
      ((sourceCell i.val).hi ≤ (2840189/5000000 : ℚ) ∨ (2840189/5000000 : ℚ) ≤ (sourceCell i.val).lo) := by

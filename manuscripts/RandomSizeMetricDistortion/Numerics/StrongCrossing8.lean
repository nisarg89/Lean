private def sourceCell (i : ℕ) : SourceCell := sourceCells.getD i ⟨0,0,fun _ => 0,fun _ => 0⟩
private def priceLambda (i : ℕ) (p : ℝ) : ℝ :=
  (∑ k : Fin 4, ((sourceCell i).lambdaCoeffs k : ℝ)*p^k.val)/(p*(1-p))
private def priceTau (i : ℕ) (p : ℝ) : ℝ :=

namespace MetricDistortion.OptimizedSSAStrong1
universe u
variable {α : Type u}

noncomputable def step (C : ℚ → α) (V : Fin 4 → α) (N : α → α) (A M : α → α → α)
    (z : α) (done : List α) : TapeOp → α
  | .const q => C q
  | .var i => V i
  | .neg a => N (done.getD a z)
  | .add a b => A (done.getD a z) (done.getD b z)
  | .mul a b => M (done.getD a z) (done.getD b z)

noncomputable def rowsAux (C : ℚ → α) (V : Fin 4 → α) (N : α → α) (A M : α → α → α)
    (z : α) (done : List α) : List TapeOp → List α
  | [] => []
  | op::ops => let row := step C V N A M z done op
              row::rowsAux C V N A M z (done++[row]) ops

variable (C : ℚ → α) (V : Fin 4 → α) (N : α → α) (A M : α → α → α) (z : α)

theorem rowsAux_length (done : List α) (ops : List TapeOp) :
    (rowsAux C V N A M z done ops).length = ops.length := by
  induction ops generalizing done with
  | nil => rfl
  | cons op ops ih => simp only [rowsAux,List.length_cons,ih]

theorem rowsAux_append (done : List α) (xs ys : List TapeOp) :
    rowsAux C V N A M z done (xs++ys) =
      rowsAux C V N A M z done xs ++
      rowsAux C V N A M z (done++rowsAux C V N A M z done xs) ys := by
  induction xs generalizing done with
  | nil => simp only [List.nil_append,rowsAux,List.append_nil]
  | cons op ops ih =>
    simp only [List.cons_append,rowsAux,ih,List.cons_append,List.append_assoc,
      List.nil_append]

theorem rowsAux_getD_prefix (done : List α) (xs ys : List TapeOp) (i : ℕ)
    (hi : i < xs.length) :
    (rowsAux C V N A M z done (xs++ys)).getD i z =
      (rowsAux C V N A M z done xs).getD i z := by
  rw [rowsAux_append]
  apply List.getD_append
  simpa only [rowsAux_length] using hi

theorem step_fixed (D : ℤ) (B : Fin 4 → FixedTape.I)
    (done : List FixedTape.Row) (op : TapeOp) :
    step (FixedTape.constRow D) (FixedTape.varRow D B)
      FixedTape.negRow FixedTape.addRow (FixedTape.mulRow D) FixedTape.zeroRow done op =
      FixedTape.step D B done op := by
  cases op <;> rfl

theorem rows_fixed (D : ℤ) (B : Fin 4 → FixedTape.I)
    (done : List FixedTape.Row) (ops : List TapeOp) :
    rowsAux (FixedTape.constRow D) (FixedTape.varRow D B)
      FixedTape.negRow FixedTape.addRow (FixedTape.mulRow D) FixedTape.zeroRow done ops =
      FixedTape.rowsAux D B done ops := by
  induction ops generalizing done with
  | nil => rfl
  | cons op ops ih =>
    simp only [rowsAux,FixedTape.rowsAux,step_fixed,ih]
end MetricDistortion.OptimizedSSAStrong1

def psiStar (t : ℝ) : ℝ := muStar-phiStar t
def HStar (t : ℝ) : ℝ := muStar*t-PhiStar t
def oldPotential (j : Fin 9) (a : ℝ) : ℝ :=
  if a ≤ bStar then 0 else cStar-a-eta j*psiStar a
def firstResidual (j : Fin 9) (a p r : ℝ) : ℝ :=
  a + lambdaStar p*(HStar (a+1-p)-HStar a) +
    tauStar j p*psiStar r + oldPotential j a-cStar
def internalResidual (j : Fin 9) (a p A r : ℝ) : ℝ :=
  a + lambdaStar p*(HStar (a+A-p)-HStar a-HStar A) +
    tauStar j p*psiStar r + oldPotential j a-oldPotential j A
def FiniteFamily (j : Fin 9) : Prop :=
  (∀ r ∈ root j ∪ Icc bStar 1, ∀ p ∈ Ioo (0 : ℝ) 1,
    ∀ a, 0 ≤ a → a ≤ min p r → firstResidual j a p r ≤ 0) ∧
  (∀ r ∈ root j ∪ Icc bStar 1, ∀ p ∈ Ioo (0 : ℝ) 1,
    ∀ a A, 0 ≤ a → a ≤ p → p ≤ A → A ≤ r → internalResidual j a p A r ≤ 0)
def StrongCrossing (j : Fin 9) : Prop :=
  ∀ p ∈ Ioo (0 : ℝ) 1, ∀ a A r, 0 ≤ a → a ≤ min p bStar →
    max p bStar ≤ A → bStar < A → A ≤ r → r ≤ 1 → internalResidual j a p A r + shift j ≤ 0
def EndpointFamily (j : Fin 9) : Prop :=
  ∀ D, IsStarLaw D → ∀ r ∈ root j ∪ Icc bStar 1,
    ∀ p ∈ ({0,1} : Set ℝ), ∀ a A,
      0 ≤ a → a ≤ min p r → p ≤ A → A ≤ 1 → LocalCut D fixedWitness j a p A r
end MetricDistortion

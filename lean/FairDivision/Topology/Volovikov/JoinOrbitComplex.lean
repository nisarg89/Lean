import FairDivision.Topology.Volovikov.JoinOrbitIntersection

/-!
# The finite subcomplex generated by a free orbit of join faces

The orbit subcomplex consists of all nonempty subfaces of translated copies
of one face. It is invariant under translation and its realization is the
finite union of the corresponding full simplex cells.
-/

set_option autoImplicit false

namespace FairDivision.Topology.Volovikov

open FairDivision.Topology.NerveConnectivity
open scoped Classical

/-- The simplicial subcomplex generated by all translates of one face. -/
def joinFaceOrbitComplex {m : ℕ} {G : Type*}
    [AddGroup G] (R : Finset (Fin m × G)) :
    PreAbstractSimplicialComplex (Fin m × G) where
  faces := {S | S.Nonempty ∧ ∃ a : G, S ⊆ translateJoinFace a R}
  isRelLowerSet_faces := by
    intro S hS
    constructor
    · exact hS.1
    · intro T hTS hT
      obtain ⟨a, ha⟩ := hS.2
      exact ⟨hT, a, hTS.trans ha⟩

/-- Every translated full cell is contained in the orbit complex. -/
theorem fullFaceComplex_le_joinFaceOrbitComplex {m : ℕ} {G : Type*}
    [AddGroup G] (R : Finset (Fin m × G)) (a : G) :
    fullFaceComplex (translateJoinFace a R) ≤
      joinFaceOrbitComplex R := by
  intro S hS
  exact ⟨hS.1, a, hS.2⟩

/-- A point lies in the orbit subcomplex precisely when it lies in one
of the translated full cells. -/
theorem mem_joinFaceOrbitRealization_iff {m : ℕ} {G : Type*}
    [AddGroup G] [Fintype G]
    (R : Finset (Fin m × G))
    (w : stdSimplex ℝ (Fin m × G)) :
    w ∈ simplicialRealization (joinFaceOrbitComplex R) ↔
      ∃ a : G, w ∈ simplicialRealization
        (fullFaceComplex (translateJoinFace a R)) := by
  constructor
  · intro hw
    obtain ⟨hne, a, hsub⟩ := hw
    exact ⟨a, hne, hsub⟩
  · rintro ⟨a, hwa⟩
    exact ⟨hwa.1, a, hwa.2⟩

/-- The orbit complex is invariant under simultaneous group translation. -/
theorem joinFaceOrbitComplex_invariant {m : ℕ} {G : Type*}
    [AddGroup G] (R : Finset (Fin m × G)) :
    IsJoinTranslationInvariant (joinFaceOrbitComplex R) := by
  intro c S hS
  obtain ⟨a, ha⟩ := hS.2
  refine ⟨hS.1.image _, c + a, ?_⟩
  have hsub := Finset.image_subset_image
    (f := translateJoinVertex c) ha
  change translateJoinFace c S ⊆
    translateJoinFace c (translateJoinFace a R) at hsub
  simpa only [← translateJoinFace_add] using hsub

/-- The union of an invariant old complex and one orbit complex remains
invariant. -/
theorem joinOrbitAttach_invariant {m : ℕ} {G : Type*}
    [AddGroup G]
    (A : PreAbstractSimplicialComplex (Fin m × G))
    (hA : IsJoinTranslationInvariant A)
    (R : Finset (Fin m × G)) :
    IsJoinTranslationInvariant (A ⊔ joinFaceOrbitComplex R) := by
  intro a S hS
  rcases hS with hSA | hSO
  · exact Or.inl (hA a S hSA)
  · exact Or.inr (joinFaceOrbitComplex_invariant R a S hSO)

/-- If the representative face is new, every translate of it is new in
an invariant old complex. -/
theorem translatedJoinFace_not_old {m : ℕ} {G : Type*}
    [AddGroup G]
    (A : PreAbstractSimplicialComplex (Fin m × G))
    (hA : IsJoinTranslationInvariant A)
    (R : Finset (Fin m × G)) (hRnot : R ∉ A)
    (a : G) : translateJoinFace a R ∉ A := by
  intro hRa
  have hback := hA (-a) (translateJoinFace a R) hRa
  rw [← translateJoinFace_add, neg_add_cancel,
    translateJoinFace_zero] at hback
  exact hRnot hback

/-- Every proper face of every translated new cell already belongs to
the preceding skeleton, hence to any old complex containing it. -/
theorem translatedJoinFace_proper_old {m d : ℕ} {G : Type*}
    [AddGroup G]
    (A : PreAbstractSimplicialComplex (Fin m × G))
    (hOld : universalJoinSkeleton m G d ≤ A)
    (R : Finset (Fin m × G)) (hR : IsUniversalJoinFace R)
    (hcard : R.card = d + 1)
    (a : G) (T : Finset (Fin m × G))
    (hT : T.Nonempty) (hTR : T ⊂ translateJoinFace a R) :
    T ∈ A := by
  have hcell : translateJoinFace a R ∈
      universalJoinSkeleton m G (d + 1) := by
    refine ⟨universalJoinFace_translate hR a, ?_⟩
    rw [translateJoinFace_card, hcard]
  have hcarda : (translateJoinFace a R).card = d + 1 := by
    rw [translateJoinFace_card, hcard]
  exact hOld (universalJoinSkeleton_properFace_old hcell hcarda hT hTR)

/-- The complex generated by a join-face orbit stays inside the full
universal join. -/
theorem joinFaceOrbitComplex_le_universalJoinComplex
    {m : ℕ} {G : Type*} [AddGroup G]
    (R : Finset (Fin m × G)) (hR : IsUniversalJoinFace R) :
    joinFaceOrbitComplex R ≤ universalJoinComplex m G := by
  intro S hS
  obtain ⟨hSnonempty, a, hsub⟩ := hS
  exact ((universalJoinComplex m G).isRelLowerSet_faces
    (universalJoinFace_translate hR a)).2 hsub hSnonempty

/-- If the representative has `d + 1` vertices, its whole orbit complex
lies in the `(d+1)`-vertex skeleton. -/
theorem joinFaceOrbitComplex_le_skeleton
    {m d : ℕ} {G : Type*} [AddGroup G]
    (R : Finset (Fin m × G)) (hR : IsUniversalJoinFace R)
    (hcard : R.card = d + 1) :
    joinFaceOrbitComplex R ≤ universalJoinSkeleton m G (d + 1) := by
  intro S hS
  have hface : IsUniversalJoinFace S :=
    (joinFaceOrbitComplex_le_universalJoinComplex R hR) hS
  obtain ⟨_, a, hsub⟩ := hS
  refine ⟨hface, ?_⟩
  have hle := Finset.card_le_card hsub
  rw [translateJoinFace_card, hcard] at hle
  exact hle

/-- In an invariant complex, once a representative face is present, its
whole translated orbit subcomplex is already present. -/
theorem joinFaceOrbitComplex_le_of_representative_mem
    {m : ℕ} {G : Type*} [AddGroup G]
    (A : PreAbstractSimplicialComplex (Fin m × G))
    (hA : IsJoinTranslationInvariant A)
    (R : Finset (Fin m × G)) (hR : R ∈ A) :
    joinFaceOrbitComplex R ≤ A := by
  intro S hS
  obtain ⟨hSnonempty, a, hsub⟩ := hS
  exact (A.isRelLowerSet_faces (hA a R hR)).2 hsub hSnonempty

end FairDivision.Topology.Volovikov
